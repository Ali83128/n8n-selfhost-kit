# Copy to .env (install.sh does this and fills the secrets for you).
N8N_VERSION=1.64.3
N8N_HOST=n8n.example.com
ACME_EMAIL=admin@example.com
TZ=UTC
POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me
# Optional off-site backups via rclone (remote:path), leave empty to disable
RCLONE_REMOTE=
BACKUP_KEEP_DAYS=14
